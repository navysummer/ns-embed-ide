<?xml version="1.0"?>
<device>
  <name>STM32G431RB</name>
  <vendor>STMicroelectronics</vendor>
  <cpu><name>CM4</name></cpu>
  <peripherals>
    <peripheral>
      <name>RCC</name>
      <baseAddress>0x40021000</baseAddress>
      <description>Reset and clock control</description>
      <registers>
        <register><name>CR</name><addressOffset>0x0</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Clock control</description><fields>
          <field><name>HSION</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>HSEON</name><bitOffset>16</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>PLLON</name><bitOffset>24</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
        <register><name>CFGR</name><addressOffset>0x4</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Clock configuration</description><fields>
          <field><name>SW</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth></field>
          <field><name>PPRE1</name><bitOffset>8</bitOffset><bitWidth>3</bitWidth></field>
          <field><name>PPRE2</name><bitOffset>11</bitOffset><bitWidth>3</bitWidth></field>
        </fields></register>
        <register><name>AHB1ENR</name><addressOffset>0x48</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>AHB1 peripheral clock enable</description><fields>
          <field><name>GPIOAEN</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>GPIOBEN</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>GPIOCEN</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
        <register><name>APB2ENR</name><addressOffset>0x60</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>APB2 peripheral clock enable</description><fields>
          <field><name>USART1EN</name><bitOffset>14</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>SPI1EN</name><bitOffset>12</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
        <register><name>APB1ENR1</name><addressOffset>0x58</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>APB1 peripheral clock enable 1</description><fields>
          <field><name>TIM2EN</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>TIM3EN</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>USART2EN</name><bitOffset>17</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>GPIOA</name>
      <baseAddress>0x48000000</baseAddress>
      <description>General purpose I/O A</description>
      <registers>
        <register><name>MODER</name><addressOffset>0x0</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Mode</description><fields>
          <field><name>MODER0</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth></field>
          <field><name>MODER1</name><bitOffset>2</bitOffset><bitWidth>2</bitWidth></field>
        </fields></register>
        <register><name>ODR</name><addressOffset>0x14</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Output data</description></register>
        <register><name>IDR</name><addressOffset>0x10</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Input data</description></register>
        <register><name>BSRR</name><addressOffset>0x18</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Bit set/reset</description></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>USART1</name>
      <baseAddress>0x40013800</baseAddress>
      <description>Universal synchronous/asynchronous receiver/transmitter</description>
      <registers>
        <register><name>ISR</name><addressOffset>0x0</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Interrupt status</description><fields>
          <field><name>RXNE</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>TC</name><bitOffset>6</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>TXE</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
        <register><name>RDR</name><addressOffset>0x24</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Receive data</description></register>
        <register><name>TDR</name><addressOffset>0x28</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Transmit data</description></register>
        <register><name>BRR</name><addressOffset>0xC</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Baud rate</description></register>
        <register><name>CR1</name><addressOffset>0x10</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Control 1</description><fields>
          <field><name>UE</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>TE</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth></field>
          <field><name>RE</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth></field>
        </fields></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM2</name>
      <baseAddress>0x40000000</baseAddress>
      <description>General purpose timer</description>
      <registers>
        <register><name>CR1</name><addressOffset>0x0</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Control 1</description></register>
        <register><name>CNT</name><addressOffset>0x24</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Counter</description></register>
        <register><name>PSC</name><addressOffset>0x28</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Prescaler</description></register>
        <register><name>ARR</name><addressOffset>0x2C</addressOffset><size>0x20</size><resetValue>0x0</resetValue><description>Auto-reload</description></register>
      </registers>
    </peripheral>
  </peripherals>
  <memory>
    <memory><name>FLASH</name><start>0x08000000</start><size>0x20000</size><access>rx</access></memory>
    <memory><name>RAM</name><start>0x20000000</start><size>0x8000</size><access>rw</access></memory>
  </memory>
</device>
